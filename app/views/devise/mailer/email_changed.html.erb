<p><%= t("devise.mailer.email_changed.greeting", email: @email, default: "Hello %{email}!") %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t("devise.mailer.email_changed.message_unconfirmed", new_email: @resource.unconfirmed_email, default: "We're contacting you to notify you that your email is being changed to %{new_email}.") %></p>
<% else %>
  <p><%= t("devise.mailer.email_changed.message", new_email: @resource.email, default: "We're contacting you to notify you that your email has been changed to %{new_email}.") %></p>
<% end %>