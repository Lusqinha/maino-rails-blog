<p><%= t("devise.mailer.confirmation_instructions.greeting", email: @email, default: "Welcome %{email}!") %></p>

<p><%= t("devise.mailer.confirmation_instructions.instruction", default: "You can confirm your account email through the link below:") %></p>

<p><%= link_to t("devise.mailer.confirmation_instructions.action", default: "Confirm my account"), confirmation_url(@resource, confirmation_token: @token) %></p>