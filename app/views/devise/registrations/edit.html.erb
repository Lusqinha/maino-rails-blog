<div class="auth-container">
  <h2 class="auth-header">
    <%= t("devise.registrations.edit.title", resource: t('activerecord.models.user.one'), default: "Edit %{resource}" ) %>
  </h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <div class="error-messages">
      <%= render "users/shared/error_messages", resource: resource %>
    </div>

    <div class="field">
      <%= f.label :name, t("activerecord.attributes.models.user.one", default: "Nome" ) %><br />
      <%= f.text_field :name, autocomplete: "name", class: "input-field" %>
    </div>

    <div class="field">
      <%= f.label :email, t("activerecord.attributes.user.email", default: "E-mail" ) %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="confirmation-message">
        <%= t("devise.registrations.edit.currently_waiting_confirmation_for_email", email: resource.unconfirmed_email) %>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :password, t("devise.passwords.edit.new_password", default: "Senha" ) %>
      <i class="password-hint">
        (<%= t("devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it") %>)
      </i><br />
      <%= f.password_field :password, autocomplete: "new-password", class: "input-field" %>
      <% if @minimum_password_length %>
        <em class="password-min-length">
          <%= t("devise.shared.minimum_password_length.other", count: @minimum_password_length) %>
        </em>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, t("devise.registrations.edit.confirm_new_password", default: "Confirme sua senha" ) %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field" %>
    </div>

    <div class="field">
      <%= f.label :current_password, t("activerecord.attributes.user.current_password", default: "Senha atual" ) %>
      <i class="current-password-hint">
        (<%= t("devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes") %>)
      </i><br />
      <%= f.password_field :current_password, autocomplete: "current-password", class: "input-field" %>
    </div>

    <div class="actions">
      <%= f.submit t("devise.registrations.edit.update", default: "Atualizar" ), class: "btn-submit" %>
    </div>
  <% end %>

  <h3 class="cancel-account-header">
    <%= t("devise.registrations.edit.cancel_my_account", default: "Cancelar minha conta" ) %>
  </h3>

  <div class="cancel-account-container">
    <p class="cancel-account-message">
      <%= t("devise.registrations.edit.unhappy", default: "Não está contente?" ) %>
    </p>
    <%= button_to t("devise.registrations.edit.cancel_my_account", default: "Cancelar minha conta" ),
      registration_path(resource_name),
      data: { confirm: t("devise.registrations.edit.are_you_sure", default: "Você tem certeza?" ) },
      method: :delete, class: 'btn btn-danger' %>
  </div>

  <div class="back-link">
    <%= link_to t("devise.shared.links.back", default: "Voltar" ), :back, class: "btn-back" %>
  </div>
</div>
