<div class="auth-container">
  <h2 class="auth-header"><%= t("devise.registrations.new.sign_up", default: "Sign up") %></h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <div class="error-messages">
      <%= render "users/shared/error_messages", resource: resource %>
    </div>

    <div class="field">
      <%= f.label :name, t("activerecord.models.user.one", default: "Name") %><br />
      <%= f.text_field :name, class: "input-field" %>
    </div>

    <div class="field">
      <%= f.label :email, t("activerecord.attributes.user.email", default: "Email") %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field" %>
    </div>

    <div class="field">
      <%= f.label :password, t("activerecord.attributes.user.password", default: "Password") %>
      <% if @minimum_password_length %>
        <em class="password-hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password", class: "input-field" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, t("activerecord.attributes.user.password_confirmation", default: "Password confirmation") %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field" %>
    </div>

    <div class="actions">
      <%= f.submit t("devise.registrations.new.sign_up", default: "Sign up"), class: "btn-submit" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= render "users/shared/links" %>
  </div>
</div>
