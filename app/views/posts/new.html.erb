<h1><%= t('posts.new_post') %></h1>

<%= form_with model: @post, local: true do |f| %>
  <div class="field">
    <%= f.label :title, t('posts.title') %>
    <%= f.text_field :title %>
  </div>
  <div class="field">
    <%= f.label :content, t('posts.content') %>
    <%= f.text_area :content %>
  </div>
  <div class="field">
    <%= f.label :tags, t('posts.tags') %>
    <%= f.text_field :tag_names, value: @post.tags.map(&:name).join(", ") %>
  </div>
  <div class="actions">
    <%= f.submit t('posts.save') %>
  </div>
<% end %>