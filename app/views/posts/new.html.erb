<h1>Criar Novo Post</h1>

<%= form_with model: @post, local: true do |f| %>
    <div>
        <%= f.label :title, "Título" %>
            <%= f.text_field :title %>
    </div>
    <div>
        <%= f.label :content, "Conteúdo" %>
            <%= f.text_area :content %>
    </div>
    <div>
        <%= f.submit "Salvar Post" %>
    </div>
    <% end %>