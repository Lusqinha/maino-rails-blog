<h1>
  <%= @post.title %>
</h1>
<p>
  <%= @post.content %>
</p>

<h2>Comentários</h2>
<%= render @post.comments %>

  <%= form_with model: [@post, @comment], local: true do |f| %>
    <div>
      <%= f.label :content, "Novo Comentário" %>
        <%= f.text_area :content %>
    </div>
    <%= f.submit "Comentar" %>
      <% end %>

        <% if user_signed_in? %>
          <p>Você está logado e seu comentário será associado ao seu usuário.</p>
          <% else %>
            <p>Você está deslogado e comentará como anônimo.</p>
            <% end %>

              <%= link_to "Editar" , edit_post_path(@post) if current_user==@post.user %>
                <%= link_to "Excluir" , @post, method: :delete, data: { confirm: "Tem certeza?" } if
                  current_user==@post.user %>