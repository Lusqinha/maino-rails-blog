<h1><%= @post.title %></h1>
<p><%= @post.content %></p>

<h2>Comentários</h2>
<%= render @post.comments %> <% if user_signed_in? %> <%= form_with model:
[@post, @comment], local: true do |f| %>
<div>
  <%= f.label :content, "Novo Comentário" %> <%= f.text_area :content %>
</div>
<%= f.submit "Comentar" %> <% end %> <% else %>
<p>Faça login para comentar.</p>
<% end %> <%= link_to "Editar" , edit_post_path(@post) if
current_user==@post.user %> <%= link_to "Excluir" , @post, method: :delete,
data: { confirm: "Tem certeza?" } if current_user==@post.user %>
