<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Maino Rails Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <%= csrf_meta_tags %> <%= csp_meta_tag %> <%= yield :head %> <%# Enable PWA
    manifest for installable apps (make sure to enable in config/routes.rb too!)
    %> <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <%# Includes all stylesheet files in app/assets/stylesheets %> <%=
    stylesheet_link_tag :app, "data-turbo-track": "reload" %>

  </head>

  <body>
    <header class="header">
      <nav class="navbar">
        <div class="navbar-user">
          <%= link_to do %>
            <%= image_tag("profile.svg", alt: "User", size: "40x35") %>
          <% end %>
          <div class="navbar-user-dropdown">
            <% if user_signed_in? %>
              <%= link_to t('posts.new_post'), new_post_path %>
              <%# <%= link_to t('my_posts'), user_posts_path(current_user) %>
              <%= link_to t('devise.registrations.edit.title', resource: ""), edit_user_registration_path %>
              <%= button_to t('logout'), destroy_user_session_path, method: :delete %> 
            <% else %>
              <%= link_to t('login'), new_user_session_path %>
              <%= link_to t('sign_up'), new_user_registration_path %>
            <% end %>
          </div>
        </div>

        <%= link_to root_path do %>
          <%= image_tag("logo.svg", alt: "Maino Rails Blog", size: "100x35") %>
        <% end %>

        <div class="navbar-langs">
          <%= link_to url_for(request.params.merge(locale: :en)) do %>
            <%= image_tag("en.svg", alt: "EN", size: "38x35") %>
          <% end %>
          /
          <%= link_to url_for(request.params.merge(locale: :'pt_BR')) do %>
            <%= image_tag("br.svg", alt: "PT-BR", size: "38x35") %>
          <% end %>
          
        </div>
      </nav>
    </header>
    <% if notice %>
      <p class="notice-sucess" onclick="this.style.display='none';" >
        <%= notice %>
      </p>
    <% end %>
    <% if alert %>
      <p class="notice-error" onclick="this.style.display='none';" >
        <%= alert %>
      </p>
    <% end %>

    <%= yield %>
  </body>
</html>